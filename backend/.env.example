# RuleLens Backend Configuration

# Application
APP_NAME=RuleLens
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database (PostgreSQL with pgvector)
# Example using postgres user/password locally or via Docker:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5434/rulelens
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Admin Panel
ADMIN_API_KEY=rulelens-admin
MAX_UPLOAD_SIZE_MB=20

# Embedding & LLM (for upcoming RAG phases)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=gemini
